9852 XP=INT(XS+(XE-XS)*I/30) :: YP=INT(YS+(YE-YS)*I/30)
9854 CALL LOCATE(#3,YP,XP)
9856 RR=INT((YP+3)/8)+1 :: CC=INT((XP+3)/8)+1
9858 IF RR>=8 AND RR<=13 THEN CALL HCHAR(RR,CC,140,1)
9860 NEXT I
9862 CALL HCHAR(SR,SC,141,1) :: CALL HCHAR(ER,EC,141,1)
9864 FOR D=1 TO 300 :: NEXT D
9866 CALL DELSPRITE(#3) :: CALL MAGNIFY(1)
9868 N=EL :: VR=17
9870 RETURN
9900 REM === PLAY AGAIN? SETS AG=1 FOR YES ===
9910 TX$="" :: GOSUB 8000
9915 TX$="PLAY AGAIN? Y OR N" :: GOSUB 8000
9920 CALL KEY(0,K,S)
9922 IF S<>0 THEN 9920
9925 CALL KEY(0,K,S)
9930 IF S=0 THEN 9925
9935 AG=0
9937 IF K=89 OR K=121 THEN AG=1
9940 RETURN
